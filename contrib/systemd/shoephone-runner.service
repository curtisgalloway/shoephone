#
# shoephone-runner as a systemd service on the runner host.
#
# Install:  cp contrib/systemd/shoephone-runner.service /etc/systemd/system/
#           install -m 0600 shoephone-runner.toml /etc/shoephone-runner/shoephone-runner.toml
#           systemctl enable --now shoephone-runner
#           (contrib/runner/README.md has the users, directories and firewall.)
#
# The runner runs as root because it must drop to two unprivileged users
# (review_user and terraform_user), chown job directories to them, and read
# the secrets identity. This unit therefore cannot be as tight as
# shoephoned.service. What it does take away: a read-only system, a private
# /tmp, no home directories, and every capability except the six the runner
# and bubblewrap use. State and logs are the only writable paths; keep
# ReadWritePaths= equal to state_dir and log_dir in the config.

[Unit]
Description=shoephone runner (Terraform with phone-approved plans)
Documentation=https://github.com/curtisgalloway/shoephone
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/shoephone-runner --config /etc/shoephone-runner/shoephone-runner.toml run
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
UMask=0077

ReadWritePaths=/var/lib/shoephone-runner /var/log/shoephone-runner

# Capabilities, and why each is kept:
#   CAP_SETUID CAP_SETGID  drop to review_user and terraform_user.
#   CAP_CHOWN CAP_FOWNER   hand a job directory to the worker user.
#   CAP_DAC_OVERRIDE       read and clean up files a worker user owns.
#   CAP_KILL               kill a worker running as another uid when its
#                          timeout expires. Without it kill() fails with
#                          EPERM and the wait on the child never returns.
#   CAP_SYS_ADMIN          bubblewrap needs it to create its mount, PID and
#                          user namespaces when it is not allowed to use
#                          unprivileged user namespaces on this kernel.
#   CAP_SETPCAP            a setuid bwrap's capabilities are capped by this
#                          bounding set, and `--cap-drop ALL` typically needs
#                          this one.
#   CAP_SYS_CHROOT         bwrap commonly needs it to pivot into its root.
# Drop any of these only after testing on the runner host that
# `cargo test bwrap_hides_runner_secrets -- --ignored` still passes under
# this unit (contrib/runner/README.md, Linux checks).
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_KILL CAP_SYS_ADMIN CAP_SETPCAP CAP_SYS_CHROOT

# bubblewrap is installed setuid root on some distributions and gets its
# privilege from that bit. NoNewPrivileges=yes would turn the bit off, and
# RestrictSUIDSGID=yes would forbid it. Both must stay "no" for that setup.
# If bwrap on this host uses unprivileged user namespaces instead (Debian,
# Ubuntu, Fedora and Arch ship it that way), both may be set to yes. Rerun
# the ignored sandbox test after either change.
NoNewPrivileges=no
RestrictSUIDSGID=no

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
# Not set: ProtectKernelTunables, ProtectKernelLogs and ProtectHostname.
# Each overmounts part of /proc, and while any part of /proc is overmounted
# the kernel refuses the fresh procfs that bwrap mounts (`--proc /proc`)
# inside an unprivileged user namespace: every job fails at init with
# "bwrap: Can't mount proc on /proc: Operation not permitted". Measured on
# Debian 13 (kernel 6.12, systemd 257) with systemd-run as an unprivileged
# user: each of the three fails alone, and the rest of this unit passes. A
# setuid bwrap mounts /proc as real root and is not affected, so a host
# with one may turn them back on. Terraform runs inside bwrap's own
# namespaces either way, which these settings never reached.
# AF_NETLINK: resolvers and the Go-based Terraform providers query routes
# and interfaces. Terraform inherits this restriction.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
